# ============================================================================
# Nexus (Enterprise CFO + Personal) — Environment Variables
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ============================================================================

# --- Database (MongoDB) ---
MONGO_URL=
DB_NAME=

# --- App URLs ---
# Public base URL of the deployed app (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_BASE_URL=

# --- Auth (NextAuth v5) ---
# Generate a strong secret, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Usually the same as NEXT_PUBLIC_BASE_URL in production
NEXTAUTH_URL=

# --- Security / CORS ---
# Explicit allowed origin for API CORS (do NOT use "*" in production).
# Typically the production origin, e.g. https://your-app.vercel.app
CORS_ORIGINS=
# Optional: override the CSP frame-ancestors allow-list (space separated).
# Defaults to "'self' https://*.emergentagent.com https://*.emergentcf.cloud".
# For production, set to your own origin, e.g. "'self' https://your-app.vercel.app"
FRAME_ANCESTORS=

# --- LLM provider (Emergent Universal LLM Gateway) ---
# Used ONLY for natural-language routing/extraction/explanation.
# All financial math is deterministic and never uses the LLM.
EMERGENT_LLM_KEY=

# --- Payments (Razorpay — TEST/sandbox for beta) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Founder / Admin analytics allow-list ---
# Comma-separated emails granted access to /admin/analytics
FOUNDER_EMAILS=
